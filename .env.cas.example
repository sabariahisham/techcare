# ============================================================================
# CAS/SATUID Configuration for Dev/Production Server
# ============================================================================
# Copy these values to your .env file when testing CAS authentication

# CAS Server Configuration
CAS_HOSTNAME=satuid.treasury.gov.my
CAS_PORT=443
CAS_URI=/gk

# Your Application URL (update based on environment)
# Dev Server Example:
CAS_CLIENT_SERVICE=http://ehelp-dev.treasury.gov.my
# Production Example:
# CAS_CLIENT_SERVICE=https://ehelp.treasury.gov.my

# Where to redirect after successful login
CAS_REDIRECT_PATH=/dashboard

# CAS Logout URLs
CAS_LOGOUT_URL=https://satuid.treasury.gov.my/gk/logout
CAS_LOGOUT_REDIRECT=http://ehelp-dev.treasury.gov.my

# ============================================================================
# Important Notes:
# ============================================================================
# 1. Make sure CAS_CLIENT_SERVICE matches your actual server URL
# 2. The URL must be accessible from SATUID server
# 3. Test users must exist in your database with matching id_pgn_ldap
# 4. Check logs at storage/logs/laravel.log for debugging
